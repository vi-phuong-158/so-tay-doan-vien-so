# Member API — local/rehearsal configuration only. NEVER commit real credentials here.
# Copy to `.env` (gitignored) and fill in local values.

# Local PostgreSQL 16 (or an equivalent test/rehearsal instance). NOT the Vibe Host v2 production
# instance — that is a separate, not-yet-provisioned target (see
# docs/phase-5-5/01-member-infrastructure-decision.md). NOT Supabase's own Postgres.
MEMBER_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/member_api_dev

# Port the Member API HTTP server listens on.
PORT=8080

# P5.5-02 authorization bridge — Supabase Edge Function resolve-member-scope. Local dev default
# points at the local Supabase stack (`supabase start`). NOT a production URL.
MEMBER_SCOPE_RESOLVER_URL=http://127.0.0.1:54321/functions/v1/resolve-member-scope

# Shared server-to-server secret with resolve-member-scope (same value as
# supabase/functions/.env's MEMBER_SCOPE_RESOLVER_SECRET for local dev/CI). NEVER a real production
# secret in this file — see supabase/functions/.env for why the local/CI value is a fixed
# non-sensitive placeholder.
MEMBER_SCOPE_RESOLVER_SECRET=local-dev-only-member-scope-secret-not-for-production

# P5.5-03 fix — verifying a Member's `work_unit_code` against Supabase's own `organizations` table
# (the sole source of truth, muc 6), reusing its already-existing RLS-protected REST endpoint.
# SUPABASE_URL/SUPABASE_ANON_KEY are the SAME public values the frontend already ships
# (`.env.example` at the repo root, `VITE_SUPABASE_URL`/`VITE_SUPABASE_ANON_KEY`) — the anon key is
# not a secret, and this is never the service-role key. Local dev default points at the local
# Supabase stack (`supabase start`).
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=local-dev-anon-key-see-root-env-example

# P5.5-06 — the browser (Vite dev server / deployed frontend) calls this API cross-origin, so it
# needs CORS enabled for exactly one trusted origin (never a wildcard, since requests carry a real
# Authorization bearer token). Local dev default is Vite's default dev server origin. Production
# value is an OWNER/DEPLOYMENT DECISION (same open item as
# docs/phase-5-5/00-member-management-architecture.md muc 28.3 — Member API domain/TLS arrangement
# — the two are resolved together) — never guess/hardcode a production frontend origin here.
CORS_ALLOWED_ORIGIN=http://localhost:5173
