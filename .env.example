VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# Không đặt service role key, Gemini key hoặc email provider key trong biến VITE_*.
# P3-03 Edge Function / trusted worker secrets (never expose through VITE_*).
CRON_SECRET=
EMAIL_PROVIDER=RESEND
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=
EMAIL_PROVIDER_BASE_URL=https://api.resend.com
EMAIL_PROVIDER_TIMEOUT_MS=10000
EMAIL_WORKER_BATCH_SIZE=20
EMAIL_WORKER_LEASE_SECONDS=300
APP_URL=https://your-project.example

# P3-R1 email delivery safety gate. Fail-closed: missing or unrecognized values behave as OFF.
# OFF        = worker never claims a queue row and never calls the provider (default; safe to deploy anywhere).
# ALLOWLIST  = worker claims and renders, but only sends to an exact-match recipient in EMAIL_TEST_RECIPIENTS;
#              everyone else is rejected fail-closed as terminal FAILED with RECIPIENT_NOT_ALLOWLISTED.
# LIVE       = unrestricted delivery to the resolved recipient. Only set this explicitly and deliberately
#              on an environment where real email should actually be sent — never as a side effect of deploying.
EMAIL_DELIVERY_MODE=OFF
# Comma-separated, exact-match, case-insensitive. Only consulted when EMAIL_DELIVERY_MODE=ALLOWLIST.
EMAIL_TEST_RECIPIENTS=

# P5-R0 Google My Drive provider — Edge Function/backend secrets only; never VITE_* or database rows.
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
GOOGLE_DRIVE_ROOT_FOLDER_ID=
GOOGLE_DRIVE_TIMEOUT_MS=10000

# P5-03 knowledge generation — Edge Function/backend only; never use VITE_*.
GEMINI_API_KEY=
KNOWLEDGE_GENERATION_MODEL=
